#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "so101_dual_cam"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "so101_dual_cam" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </so101_dual_cam/Physics/root_joint>,
        </so101_dual_cam/Physics/shoulder_pan>,
        </so101_dual_cam/Physics/shoulder_lift>,
        </so101_dual_cam/Physics/elbow_flex>,
        </so101_dual_cam/Physics/wrist_flex>,
        </so101_dual_cam/Physics/camera_left_joint>,
        </so101_dual_cam/Physics/camera_right_joint>,
        </so101_dual_cam/Physics/wrist_roll>,
        </so101_dual_cam/Physics/gripper_frame_joint>,
        </so101_dual_cam/Physics/gripper>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </so101_dual_cam/Geometry/base_link>,
        </so101_dual_cam/Geometry/base_link/shoulder_link>,
        </so101_dual_cam/Geometry/base_link/shoulder_link/upper_arm_link>,
        </so101_dual_cam/Geometry/base_link/shoulder_link/upper_arm_link/lower_arm_link>,
        </so101_dual_cam/Geometry/base_link/shoulder_link/upper_arm_link/lower_arm_link/wrist_link>,
        </so101_dual_cam/Geometry/base_link/shoulder_link/upper_arm_link/lower_arm_link/wrist_link/camera_left_optical_frame>,
        </so101_dual_cam/Geometry/base_link/shoulder_link/upper_arm_link/lower_arm_link/wrist_link/camera_right_optical_frame>,
        </so101_dual_cam/Geometry/base_link/shoulder_link/upper_arm_link/lower_arm_link/wrist_link/gripper_link>,
        </so101_dual_cam/Geometry/base_link/shoulder_link/upper_arm_link/lower_arm_link/wrist_link/gripper_link/gripper_frame_link>,
        </so101_dual_cam/Geometry/base_link/shoulder_link/upper_arm_link/lower_arm_link/wrist_link/gripper_link/moving_jaw_so101_v1_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "shoulder_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "upper_arm_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "lower_arm_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "wrist_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "camera_left_optical_frame" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }

                            over "camera_right_optical_frame" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }

                            over "gripper_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "moving_jaw_so101_v1_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }

                                over "gripper_frame_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_frame_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder_pan" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder_lift" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "elbow_flex" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_flex" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}


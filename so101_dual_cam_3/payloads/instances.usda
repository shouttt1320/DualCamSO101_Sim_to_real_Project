    def Xform "Base_motor_holder_SO101" (
        prepend references = @./geometries.usd@</Geometries/Base_motor_holder_SO101>
    )
    {
        over "Base_motor_holder_SO101" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/Base_motor_holder_SO101/VisualMaterials/tn__3d_printed_>
        }

        def Scope "VisualMaterials"
        {
            def Material "tn__3d_printed_" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/tn__3d_printed_>
            )
            {
            }
        }
    }

    def Xform "Base_motor_holder_SO101_1" (
        prepend references = @./geometries.usd@</Geometries/Base_motor_holder_SO101>

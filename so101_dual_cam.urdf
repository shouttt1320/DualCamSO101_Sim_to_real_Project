      <origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 -1.35493e-14 1.5708"/>
      <geometry>
        <mesh filename="assets/Seeedstudio_Mounting_Plate_SO101.stl" scale="0.001 0.001 0.001"/>

      <geometry>
        <mesh filename="assets/Base_motor_holder_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708"/>
      <geometry>
        <mesh filename="assets/Base_motor_holder_SO101.stl" scale="0.001 0.001 0.001"/>
